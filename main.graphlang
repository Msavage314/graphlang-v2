

# macros
macro Rectangle($name, $x, $y, $w, $h) {
    namespace $name {
        Xpos = $x
        Ypos = $y
        Width = $w
        Height = $h
        polygon((Xpos - (Width / 2), Ypos - (Height / 2)),(Xpos + (Width / 2), Ypos - (Height /2 )),(Xpos + (Width / 2), Ypos + (Height /2 )),(Xpos - (Width / 2), Ypos + (Height /2 )))
    }
}

Rectangle!(A,1,1,1,1)

A.Xpos



fn f(x) = if x > 0 { x } else {0}